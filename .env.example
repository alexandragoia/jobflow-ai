# Optional live integrations. The synthetic demo works without a .env file.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional: enable AI explicitly in Settings after adding the key locally.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_CALLS_PER_DAY=40

# Optional online deployment. Leave unset for the local Windows launcher.
# See ONLINE.md; never put actual secrets in this example file.
# JOBFLOW_ONLINE=1
# JOBFLOW_DATA_DIR=/var/data
# JOBFLOW_ALLOWED_HOSTS=your-private-app.example
# JOBFLOW_PASSWORD_HASH=
# JOBFLOW_SESSION_SECRET=
